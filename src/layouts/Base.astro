---
import "../styles/global.css";
import TechBackground from "../components/TechBackground.astro";

interface Props {
  title?: string;
  description?: string;
  variant?: "anime" | "tech";
  wide?: boolean;
}

const {
  title = "大肥鱼的鱼塘",
  description = "折腾笔记、AI 工具，以及一些还没想明白的问题。",
  variant = "tech",
  wide = false,
} = Astro.props;

const siteName = "大肥鱼的鱼塘";
const pageTitle =
  title === siteName ? `${siteName} · 折腾笔记与 AI 工具` : `${title} · ${siteName}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const ogImage = Astro.site ? new URL("/og.jpg", Astro.site).href : "/og.jpg";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0d16" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{pageTitle}</title>
  </head>
  <body class={`variant-${variant}`}>
    {
      variant === "anime" ? (
        <div class="scene scene--anime" aria-hidden="true" />
      ) : (
        <>
          <div class="scene scene--tech" aria-hidden="true" />
          <TechBackground />
        </>
      )
    }

    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          <svg width="21" height="21" viewBox="0 0 64 64" aria-hidden="true">
            <defs>
              <linearGradient id="brand-fish" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#cfe8ff"></stop>
                <stop offset="55%" stop-color="#8cbbed"></stop>
                <stop offset="100%" stop-color="#5b8dd6"></stop>
              </linearGradient>
            </defs>
            <ellipse cx="32" cy="38" rx="20" ry="15" fill="url(#brand-fish)"></ellipse>
            <circle cx="24" cy="36" r="3.4" fill="#0a0d16"></circle>
            <circle cx="40" cy="36" r="3.4" fill="#0a0d16"></circle>
            <circle cx="25.2" cy="34.8" r="1.2" fill="#fff"></circle>
            <circle cx="41.2" cy="34.8" r="1.2" fill="#fff"></circle>
            <path
              d="M27 44c2 2 8 2 10 0"
              stroke="#0a0d16"
              stroke-width="2.6"
              fill="none"
              stroke-linecap="round"></path>
            <path
              d="M32 23V15"
              stroke="#8cbbed"
              stroke-width="3"
              stroke-linecap="round"></path>
            <circle cx="32" cy="12.5" r="3.2" fill="#f6f1e7"></circle>
          </svg>
          大肥鱼的鱼塘
        </a>
        <nav>
          <a href="/">文章</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>

    <main class={`wrap ${wide ? "wrap--post" : ""}`}>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} 大肥鱼的鱼塘 · 咕噜咕噜</p>
      <div class="links">
        <a href="https://github.com/yexuan722/dafeiyu-blog">源码</a>
        <a href="https://astro.build">Astro</a>
        <a href="https://pages.cloudflare.com">Cloudflare Pages</a>
        <a href="/about/">关于</a>
      </div>
    </footer>
  </body>
</html>
