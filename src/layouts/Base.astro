---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "大肥鱼的鱼塘",
  description = "折腾笔记、AI 工具与一些没想明白的问题。",
} = Astro.props;

const pageTitle =
  title === "大肥鱼的鱼塘" ? `${title} · ${description}` : `${title} · 大肥鱼的鱼塘`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          <svg width="19" height="19" viewBox="0 0 64 64" aria-hidden="true">
            <ellipse cx="32" cy="38" rx="20" ry="15" fill="#6ea0e8"></ellipse>
            <circle cx="24" cy="36" r="3.2" fill="#232529"></circle>
            <circle cx="40" cy="36" r="3.2" fill="#232529"></circle>
            <circle cx="25" cy="35" r="1.1" fill="#fff"></circle>
            <circle cx="41" cy="35" r="1.1" fill="#fff"></circle>
            <path
              d="M27 44c2 2 8 2 10 0"
              stroke="#232529"
              stroke-width="2.6"
              fill="none"
              stroke-linecap="round"></path>
            <path
              d="M32 23V15"
              stroke="#6ea0e8"
              stroke-width="3"
              stroke-linecap="round"></path>
            <circle cx="32" cy="13" r="3" fill="#f6f1e7"></circle>
          </svg>
          大肥鱼的鱼塘
        </a>
        <nav>
          <a href="/">文章</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} yexuan.qzz.io ·
        <a href="https://astro.build">Astro</a> 构建 · 托管于 Cloudflare Pages
      </p>
    </footer>
  </body>
</html>
