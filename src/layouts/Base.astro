---
import "../styles/global.css";
import TechBackground from "../components/TechBackground.astro";
import FishPet from "../components/FishPet.astro";

interface Props {
  title?: string;
  description?: string;
  variant?: "anime" | "tech";
  wide?: boolean;
  /** 首页用：不要 .wrap 的内边距，自己排版 */
  full?: boolean;
  /** 首页用：顶栏压在大图上，滚动后才落底 */
  overlay?: boolean;
  active?: "posts" | "tags" | "search" | "about";
}

const {
  title = "大肥鱼的鱼塘",
  description = "折腾笔记、AI 工具，以及一些还没想明白的问题。",
  variant = "tech",
  wide = false,
  full = false,
  overlay = false,
  active,
} = Astro.props;

const navItems = [
  { key: "posts", href: "/posts/", label: "文章" },
  { key: "tags", href: "/tags/", label: "标签" },
  { key: "search", href: "/search/", label: "搜索" },
  { key: "about", href: "/about/", label: "关于" },
] as const;

const siteName = "大肥鱼的鱼塘";
const pageTitle =
  title === siteName ? `${siteName} · 折腾笔记与 AI 工具` : `${title} · ${siteName}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const ogImage = Astro.site ? new URL("/og.jpg", Astro.site).href : "/og.jpg";

const mainClass = ["wrap", wide ? "wrap--post" : "", full ? "wrap--full" : ""]
  .filter(Boolean)
  .join(" ");
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" id="theme-color" content="#0a0d16" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{pageTitle}</title>

    {/* 首屏之前定主题，避免白屏闪一下 */}
    <script is:inline>
      (() => {
        const KEY = "dafeiyu-theme";
        let saved = null;
        try {
          saved = localStorage.getItem(KEY);
        } catch {}
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class={`variant-${variant}`}>
    {
      variant === "anime" ? (
        <div class="scene scene--anime" aria-hidden="true" />
      ) : (
        <>
          <div class="scene scene--tech" aria-hidden="true" />
          <TechBackground />
        </>
      )
    }

    <header class={`site-header ${overlay ? "is-over" : ""}`}>
      <div class="inner">
        <a class="brand" href="/">
          <svg width="21" height="21" viewBox="0 0 64 64" aria-hidden="true">
            <defs>
              <linearGradient id="brand-fish" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#cfe8ff"></stop>
                <stop offset="55%" stop-color="#8cbbed"></stop>
                <stop offset="100%" stop-color="#5b8dd6"></stop>
              </linearGradient>
            </defs>
            <ellipse cx="32" cy="38" rx="20" ry="15" fill="url(#brand-fish)"></ellipse>
            <circle cx="24" cy="36" r="3.4" fill="#0a0d16"></circle>
            <circle cx="40" cy="36" r="3.4" fill="#0a0d16"></circle>
            <circle cx="25.2" cy="34.8" r="1.2" fill="#fff"></circle>
            <circle cx="41.2" cy="34.8" r="1.2" fill="#fff"></circle>
            <path
              d="M27 44c2 2 8 2 10 0"
              stroke="#0a0d16"
              stroke-width="2.6"
              fill="none"
              stroke-linecap="round"></path>
            <path
              d="M32 23V15"
              stroke="#8cbbed"
              stroke-width="3"
              stroke-linecap="round"></path>
            <circle cx="32" cy="12.5" r="3.2" fill="#f6f1e7"></circle>
          </svg>
          <span>大肥鱼的鱼塘</span>
        </a>
        <nav>
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={active === item.key ? "is-active" : ""}
                aria-current={active === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          class="theme-btn"
          type="button"
          data-theme-toggle
          aria-label="切换到日间模式"
          aria-pressed="false"
          title="日间 / 夜间"
        >
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle>
            <path
              d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20.4 14.6A8.6 8.6 0 1 1 9.4 3.6a6.9 6.9 0 0 0 11 11Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <main class={mainClass}>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} 大肥鱼的鱼塘 · 咕噜咕噜</p>
      <p class="credit">右上角的 ☀ / ☾ 换日间夜间，选择只存在你自己的浏览器里。</p>
      <div class="links">
        <a href="https://github.com/yexuan722/dafeiyu-blog">源码</a>
        <a href="https://astro.build">Astro</a>
        <a href="https://pages.cloudflare.com">Cloudflare Pages</a>
        <a href="/about/">关于</a>
      </div>
    </footer>

    <FishPet />

    <script>
      const KEY = "dafeiyu-theme";
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const meta = document.getElementById("theme-color");

      function apply(theme: "dark" | "light") {
        root.dataset.theme = theme;
        if (meta) meta.setAttribute("content", theme === "light" ? "#f3f6fc" : "#0a0d16");
        if (btn) {
          const light = theme === "light";
          btn.setAttribute("aria-label", light ? "切换到夜间模式" : "切换到日间模式");
          btn.setAttribute("aria-pressed", String(light));
          btn.title = light ? "切回夜间" : "切到日间";
        }
        window.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
      }

      apply(root.dataset.theme === "light" ? "light" : "dark");

      btn?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        apply(next);
        try {
          localStorage.setItem(KEY, next);
        } catch {}
      });

      // 首页顶栏：开始滚动后落底，别一直透明压着图片
      const header = document.querySelector<HTMLElement>(".site-header.is-over");
      if (header) {
        const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 28);
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
