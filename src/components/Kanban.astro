---
// 看板娘：Live2D（Cubism 2），运行时和模型都放在 /live2d/ 下自托管。
// 思路来自 cnblogs 那篇 waifu.js 的文章，但换成 live2d-widget 3.x，
// 不用 jQuery、不用任何第三方 CDN / API。
---

<div class="kanban" id="kanban" hidden>
  <p class="kanban-tip" id="kanban-tip" role="status" aria-live="polite"></p>
  <button class="kanban-close" id="kanban-close" type="button" aria-label="关掉看板娘">
    ✕
  </button>
</div>

<style>
  .kanban {
    --kanban-h: 420px;
    position: fixed;
    right: 8px;
    bottom: calc(var(--kanban-h) + 6px);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .kanban[hidden] {
    display: none;
  }

  .kanban-tip {
    margin: 0;
    max-width: 190px;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: #0a1020;
    background: linear-gradient(120deg, #ffffff, #e2efff);
    box-shadow: 0 10px 26px -12px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }

  .kanban-tip.show {
    opacity: 1;
    transform: translateY(0);
  }

  .kanban-close {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 50%;
    font-size: 12px;
    line-height: 1;
    color: var(--dim);
    background: rgba(16, 21, 36, 0.8);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  /* 只有靠近/聚焦时才冒出来，平时不挡视线 */
  .kanban.is-hot .kanban-close,
  .kanban:hover .kanban-close,
  .kanban-close:focus-visible {
    opacity: 0.8;
    pointer-events: auto;
  }

  .kanban-close:hover,
  .kanban-close:focus-visible {
    opacity: 1;
    color: var(--text-strong);
    border-color: rgba(143, 192, 255, 0.5);
  }

  @media (max-width: 899px) {
    .kanban {
      display: none;
    }
  }
</style>

<script>
  const TIPS = [
    "咕噜…有事吗？",
    "本鱼正在吃白饭。",
    "点我干嘛，饭要凉了啦。",
    "今天也要干饭！",
    "唔……让本鱼想想。",
    "看完了记得回来哦。",
  ];

  const root = document.getElementById("kanban");
  const tipEl = document.getElementById("kanban-tip");
  const closeBtn = document.getElementById("kanban-close");
  const KEY = "kanban-off";

  let tipTimer = 0;

  function say(text) {
    if (!tipEl) return;
    tipEl.textContent = text;
    tipEl.classList.add("show");
    window.clearTimeout(tipTimer);
    tipTimer = window.setTimeout(() => tipEl.classList.remove("show"), 3200);
  }

  function dismiss() {
    try {
      localStorage.setItem(KEY, "1");
    } catch {
      /* 隐私模式忽略 */
    }
    document.getElementById("live2d-widget")?.remove();
    if (root) root.hidden = true;
  }

  closeBtn?.addEventListener("click", dismiss);

  function boot() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let off = false;
    try {
      off = localStorage.getItem(KEY) === "1";
    } catch {
      off = false;
    }
    if (reduce || off || window.innerWidth < 900) return;

    // 按视口高度缩放；画布尽量窄，模型靠 scale 放大，
    // 免得透明画布把正文/目录的点击吃掉
    const height = Math.max(300, Math.min(420, Math.round(window.innerHeight * 0.5)));
    const width = Math.round(height * 0.357);
    const scale = (height / 420) * 2.1;

    if (root) {
      root.style.setProperty("--kanban-h", `${height}px`);
      root.hidden = false;
    }

    const script = document.createElement("script");
    script.src = "/live2d/L2Dwidget.min.js";
    script.async = true;
    script.onload = () => {
      const L2D = window.L2Dwidget;
      if (!L2D) return;

      L2D.init({
        model: { jsonPath: "/live2d/rem.model.json", scale },
        display: {
          superSample: 2,
          width,
          height,
          position: "right",
          hOffset: 0,
          vOffset: 0,
        },
        mobile: { show: false, scale: 0.6 },
        react: { opacity: 1 },
        dev: { border: false },
      });

      let tries = 0;
      const timer = window.setInterval(() => {
        const box = document.getElementById("live2d-widget");
        if (box) {
          window.clearInterval(timer);
          box.style.pointerEvents = "auto";
          box.addEventListener("click", () => {
            say(TIPS[Math.floor(Math.random() * TIPS.length)] ?? TIPS[0]);
          });
          // 鼠标靠过去才显示关闭按钮
          box.addEventListener("pointerenter", () => root?.classList.add("is-hot"));
          box.addEventListener("pointerleave", () => root?.classList.remove("is-hot"));
        } else if (++tries > 40) {
          window.clearInterval(timer);
        }
      }, 200);
    };
    document.body.appendChild(script);
  }

  // 等页面空闲再加载，别跟首屏抢带宽
  const idleWindow = window;
  if (typeof idleWindow.requestIdleCallback === "function") {
    idleWindow.requestIdleCallback(boot, { timeout: 2500 });
  } else {
    window.setTimeout(boot, 1500);
  }
</script>
