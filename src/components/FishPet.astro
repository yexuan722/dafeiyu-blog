---
// 桌宠：可以拖着跑，点一下换一只。
// 7 张动图都是压缩过的 animated webp（240×240，单张 130–320KB，懒加载）。
const PETS = [
  { src: "/pet/working.webp", alt: "正在干活的大肥鱼", mood: "干活中", text: "本鱼在认真干活哦～今天也要好好吃饭呀", kao: "(๑•̀ㅂ•́)و✧" },
  { src: "/pet/typing.webp", alt: "正在打字的大肥鱼", mood: "敲字中", text: "啪嗒啪嗒～在给你敲字呢", kao: "(๑´ω`๑)" },
  { src: "/pet/sleepy.webp", alt: "打瞌睡的大肥鱼", mood: "犯困", text: "唔…就让本鱼眯一小会儿，饭好了叫我", kao: "(｡-ω-)zzz" },
  { src: "/pet/tired.webp", alt: "有点累的大肥鱼", mood: "鱼脑过载", text: "鱼脑过载了…咕噜咕噜，先歇口气", kao: "(｡•́︿•̀｡)" },
  { src: "/pet/angry-work.webp", alt: "生气干活的大肥鱼", mood: "炸毛", text: "谁把本鱼的饭盒藏起来了！", kao: "(╬ Ò﹏Ó)" },
  { src: "/pet/typing-annoyed.webp", alt: "有点烦的大肥鱼", mood: "有点烦", text: "这个 bug 怎么又冒出来了呀", kao: "(＃`д´)" },
  { src: "/pet/typing-angry.webp", alt: "气鼓鼓打字的大肥鱼", mood: "气鼓鼓", text: "本鱼要爆炸啦！", kao: "(╯°□°）╯" },
];
---

<div class="fishpet" id="fishpet" data-count={PETS.length}>
  <div class="fp-bubble" id="fpBubble" role="status" aria-live="polite"></div>

  <button
    class="fp-body"
    id="fpBody"
    type="button"
    aria-label="点一下换心情，按住可以拖动"
    title="点一下换心情，按住能拖着走"
  >
    <img
      id="fpImg"
      src={PETS[0].src}
      alt={PETS[0].alt}
      width="120"
      height="120"
      loading="lazy"
      decoding="async"
    />
  </button>

  <button class="fp-close" id="fpClose" type="button" aria-label="把大肥鱼收起来">✕</button>
</div>

<script is:inline define:vars={{ PETS }}>
  (() => {
    const root = document.getElementById("fishpet");
    if (!root) return;

    const body = document.getElementById("fpBody");
    const img = document.getElementById("fpImg");
    const bubble = document.getElementById("fpBubble");
    const close = document.getElementById("fpClose");
    const STORE_KEY = "fishpet-state";
    const POS_KEY = "fishpet-pos";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const conn = navigator.connection || {};
    const frugal = conn.saveData === true || /(^|-)2g$/.test(conn.effectiveType || "");

    let index = 0;
    let hidden = false;
    let bubbleTimer = 0;
    let suppressClick = false;

    // 位置（左上角，px）
    let pos = { x: 18, y: 0 };
    let dragging = false;
    let moved = false;
    let start = { x: 0, y: 0, px: 0, py: 0 };

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    try {
      const saved = JSON.parse(localStorage.getItem(STORE_KEY) || "{}");
      if (typeof saved.index === "number") index = saved.index % PETS.length;
      hidden = saved.hidden === true;
    } catch {}

    // 支持 /#pet-3 这种链接直接定格某只（方便分享和排查）
    const hash = /#pet-(\d+)/.exec(location.hash || "");
    if (hash) index = Number(hash[1]) % PETS.length;

    const save = () => {
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify({ index, hidden }));
      } catch {}
    };

    const savePos = () => {
      try {
        localStorage.setItem(POS_KEY, JSON.stringify(pos));
      } catch {}
    };

    const preloaded = new Set();
    const preload = () => {
      if (frugal) return;
      PETS.forEach((pet, i) => {
        if (i === index || preloaded.has(pet.src)) return;
        const el = new Image();
        el.src = pet.src;
        preloaded.add(pet.src);
      });
    };

    const say = (pet) => {
      // 拆两行：正文一行、颜文字一行，免得表情符号在中间被折成两截
      const text = document.createElement("span");
      text.className = "fp-say";
      text.textContent = pet.text;

      const kao = document.createElement("span");
      kao.className = "fp-kao";
      kao.textContent = pet.kao;
      kao.setAttribute("aria-hidden", "true");

      bubble.replaceChildren(text, kao);
      bubble.setAttribute("aria-label", `${pet.mood}：${pet.text} ${pet.kao}`);
      bubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => bubble.classList.remove("show"), 3600);
    };

    const show = (i) => {
      index = (i + PETS.length) % PETS.length;
      const pet = PETS[index];
      img.src = pet.src;
      img.alt = pet.alt;
      preloaded.add(pet.src);
    };

    const pop = () => {
      if (reduce) return;
      body.classList.remove("pop");
      void body.offsetWidth; // 强制重排，动画才能重放
      body.classList.add("pop");
    };

    // ---------------- 位置与拖拽 ----------------

    const place = (x, y) => {
      const rect = root.getBoundingClientRect();
      const maxX = Math.max(8, window.innerWidth - rect.width - 8);
      const maxY = Math.max(8, window.innerHeight - rect.height - 8);
      pos = { x: clamp(x, 8, maxX), y: clamp(y, 8, maxY) };
      root.style.setProperty("--pet-x", `${pos.x}px`);
      root.style.setProperty("--pet-y", `${pos.y}px`);
      // 贴到上沿时气泡翻到下面，贴右边时气泡靠右对齐
      root.classList.toggle("flip", pos.y < 160);
      root.classList.toggle("at-right", pos.x + rect.width / 2 > window.innerWidth / 2);
    };

    const restorePos = () => {
      let saved = null;
      try {
        saved = JSON.parse(localStorage.getItem(POS_KEY) || "null");
      } catch {}
      if (saved && typeof saved.x === "number" && typeof saved.y === "number") {
        place(saved.x, saved.y);
        return;
      }
      const rect = root.getBoundingClientRect();
      place(18, window.innerHeight - rect.height - 14);
    };

    body.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      dragging = true;
      moved = false;
      start = { x: event.clientX, y: event.clientY, px: pos.x, py: pos.y };
      try {
        body.setPointerCapture(event.pointerId);
      } catch {}
      root.classList.add("dragging");
    });

    body.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      if (!moved && Math.hypot(dx, dy) > 5) moved = true;
      if (!moved) return;
      place(start.px + dx, start.py + dy);
    });

    const endDrag = (event) => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove("dragging");
      try {
        body.releasePointerCapture(event.pointerId);
      } catch {}
      if (moved) {
        // 拖完别把这一次当成点击，不然一松手就换一只
        suppressClick = true;
        window.setTimeout(() => (suppressClick = false), 0);
        savePos();
      }
    };

    body.addEventListener("pointerup", endDrag);
    body.addEventListener("pointercancel", endDrag);

    window.addEventListener("resize", () => place(pos.x, pos.y), { passive: true });

    // ---------------- 点击 / 收起 ----------------

    body.addEventListener("click", () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      hidden = false;
      show(index + 1);
      pop();
      say(PETS[index]);
      save();
      // 点过一次说明愿意看，把剩下的图预热一下
      window.setTimeout(preload, 1200);
    });

    close.addEventListener("click", (event) => {
      event.stopPropagation();
      hidden = true;
      save();
      root.classList.add("is-hidden");
    });

    body.addEventListener("animationend", () => body.classList.remove("pop"));

    requestAnimationFrame(() => {
      restorePos();
      root.classList.toggle("is-hidden", hidden);
      if (!hidden) show(index);
    });

    // 首屏先不抢带宽，闲下来再预热
    if (!frugal) {
      if ("requestIdleCallback" in window) window.requestIdleCallback(preload, { timeout: 4000 });
      else window.setTimeout(preload, 3000);
    }
  })();
</script>

<style>
  .fishpet {
    --size: 120px;
    position: fixed;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    z-index: 30;
    transform: translate3d(var(--pet-x, 18px), var(--pet-y, 0px), 0);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    will-change: transform;
    transition: opacity 0.25s ease;
  }

  .fishpet.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .fp-body {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    line-height: 0;
    filter: drop-shadow(0 10px 18px rgba(6, 18, 40, 0.45));
    transform-origin: 50% 88%;
    transition: transform 0.18s ease;
  }

  .fishpet.dragging .fp-body {
    cursor: grabbing;
    transition: none;
  }

  .fp-body:hover {
    transform: translateY(-2px) scale(1.03);
  }

  .fishpet.dragging .fp-body:hover {
    transform: none;
  }

  .fp-body img {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: auto;
    pointer-events: none; /* 拖拽事件统一由按钮接 */
    animation: fp-float 4.2s ease-in-out infinite;
  }

  .fishpet.dragging .fp-body img {
    animation-play-state: paused;
  }

  /* q 弹：先压扁再回弹，带一点过冲 */
  .fp-body.pop {
    animation: fp-pop 0.58s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes fp-pop {
    0% {
      transform: scale(1);
    }
    28% {
      transform: scale(0.82, 1.16);
    }
    52% {
      transform: scale(1.14, 0.88);
    }
    72% {
      transform: scale(0.96, 1.04);
    }
    88% {
      transform: scale(1.03, 0.98);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes fp-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  /* 气泡绝对定位在鱼上方，不参与布局，拖动时不会把鱼挤歪 */
  .fp-bubble {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    /* 父级只有鱼那么宽，不写 max-content 的话气泡会被压成一条窄柱 */
    width: max-content;
    max-width: min(236px, calc(100vw - 24px));
    padding: 9px 12px 8px;
    border-radius: 14px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text, #e9eefc);
    background: var(--panel-solid, #121828);
    border: 1px solid var(--line-strong, rgba(140, 165, 220, 0.3));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    opacity: 0;
    transform: translateY(6px) scale(0.94);
    transform-origin: 24px 100%;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .fp-bubble.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .fp-bubble::after {
    content: "";
    position: absolute;
    left: 22px;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: inherit;
    border-right: 1px solid var(--line-strong, rgba(140, 165, 220, 0.3));
    border-bottom: 1px solid var(--line-strong, rgba(140, 165, 220, 0.3));
    transform: rotate(45deg);
  }

  /* 贴近视口上沿：气泡翻到鱼下面 */
  .fishpet.flip .fp-bubble {
    bottom: auto;
    top: calc(100% + 10px);
    transform-origin: 24px 0;
  }

  .fishpet.flip .fp-bubble::after {
    bottom: auto;
    top: -6px;
    transform: rotate(225deg);
  }

  /* 拖到右半边：气泡改成右对齐，别顶出屏幕 */
  .fishpet.at-right .fp-bubble {
    left: auto;
    right: 0;
  }

  .fishpet.at-right .fp-bubble::after {
    left: auto;
    right: 22px;
  }

  /* 这两个 span 是 JS 动态创建的，拿不到 Astro 的作用域属性，必须 :global */
  :global(.fp-say) {
    display: block;
    word-break: break-word;
  }

  :global(.fp-kao) {
    display: block;
    margin-top: 2px;
    text-align: right;
    white-space: nowrap;
    opacity: 0.82;
    font-size: 12px;
  }

  .fp-close {
    position: absolute;
    top: -6px;
    right: -8px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--line-strong, rgba(140, 165, 220, 0.3));
    background: var(--panel-solid, #121828);
    color: var(--dim, #97a3c2);
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .fishpet:hover .fp-close,
  .fp-close:focus-visible {
    opacity: 1;
  }

  [data-theme="light"] .fp-bubble,
  [data-theme="light"] .fp-close {
    background: rgba(255, 255, 255, 0.96);
    color: #24405f;
    border-color: rgba(80, 130, 200, 0.28);
  }

  [data-theme="light"] .fp-body {
    filter: drop-shadow(0 10px 18px rgba(40, 80, 140, 0.22));
  }

  @media (max-width: 1400px) {
    .fishpet {
      --size: 92px;
    }
  }

  /* 太窄就收起来，桌面宠在手机上只会挡路 */
  @media (max-width: 1024px) {
    .fishpet {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-body img,
    .fp-body.pop {
      animation: none;
    }
    .fp-body,
    .fp-bubble {
      transition: none;
    }
  }
</style>
