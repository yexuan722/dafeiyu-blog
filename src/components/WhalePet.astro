---
// 看板娘：DeepSeek 鲸鱼娘（Live2D Cubism 4）
// 形象：上善无形「溟月」→ ZipZipPipe 女仆鲸鱼娘 → 氵六青 制作的 Live2D
// 素材 CC BY-NC-SA 4.0（非商业），代码来自 Andersen216/dsh-whale-girl-live2d（MIT）
---

<div class="whalepet" id="whalepet" hidden>
  <p class="whalepet-tip" id="whalepet-tip" role="status" aria-live="polite"></p>
  <button
    class="whalepet-close"
    id="whalepet-close"
    type="button"
    aria-label="关掉看板娘"
  >
    ✕
  </button>
  <div class="whalepet-stage" id="whalepet-stage"></div>
</div>

<style>
  .whalepet {
    --pet-w: 220px;
    --pet-h: 200px;
    position: fixed;
    right: 0;
    bottom: 0;
    z-index: 55;
    width: var(--pet-w);
    height: var(--pet-h);
    pointer-events: none;
  }

  .whalepet[hidden] {
    display: none;
  }

  .whalepet-stage {
    width: 100%;
    height: 100%;
    pointer-events: auto;
    cursor: pointer;
    filter: drop-shadow(0 10px 24px rgba(60, 120, 220, 0.18));
  }

  .whalepet-stage canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .whalepet-tip {
    position: absolute;
    right: 12px;
    bottom: calc(var(--pet-h) + 4px);
    margin: 0;
    max-width: 200px;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: #0a1020;
    background: linear-gradient(120deg, #ffffff, #e2efff);
    box-shadow: 0 10px 26px -12px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }

  .whalepet-tip.show {
    opacity: 1;
    transform: translateY(0);
  }

  .whalepet-close {
    position: absolute;
    right: 6px;
    top: -6px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 50%;
    font-size: 12px;
    line-height: 1;
    color: var(--dim);
    background: rgba(16, 21, 36, 0.82);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .whalepet.is-hot .whalepet-close,
  .whalepet-close:focus-visible {
    opacity: 0.85;
    pointer-events: auto;
  }

  .whalepet-close:hover,
  .whalepet-close:focus-visible {
    opacity: 1;
    color: var(--text-strong);
    border-color: rgba(143, 192, 255, 0.5);
  }

  @media (max-width: 899px) {
    .whalepet {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whalepet {
      display: none;
    }
  }
</style>

<script>
  const TIPS = [
    "咕噜…本鱼在算题，别吵。",
    "这个站也是用我算出来的哦。",
    "点我干嘛，饭要凉了啦。",
    "今天也要干饭！",
    "鲸鱼尾巴不是用来摸的。",
    "唔……让本鱼想想。",
  ];

  const EXPRESSIONS = ["happy", "blush", "star", "heart"];
  const MOTIONS = ["selfie", "ketchup", "bubble", "splash", "openlid"];

  // 模型坐标系里人物的实际包围盒（用洋红底截出来量的）
  const ART = { x: 567, y: 369, w: 3447, h: 3148 };
  const KEY = "whalepet-off";

  const root = document.getElementById("whalepet");
  const stage = document.getElementById("whalepet-stage");
  const tipEl = document.getElementById("whalepet-tip");
  const closeBtn = document.getElementById("whalepet-close");

  let tipTimer = 0;
  let app: any = null;
  let model: any = null;

  function say(text: string) {
    if (!tipEl) return;
    tipEl.textContent = text;
    tipEl.classList.add("show");
    window.clearTimeout(tipTimer);
    tipTimer = window.setTimeout(() => tipEl.classList.remove("show"), 3400);
  }

  function dismiss() {
    try {
      localStorage.setItem(KEY, "1");
    } catch {
      /* 隐私模式忽略 */
    }
    try {
      app?.destroy(true, { children: true });
    } catch {
      /* 忽略 */
    }
    if (root) root.hidden = true;
  }

  closeBtn?.addEventListener("click", dismiss);

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = src;
      el.async = false;
      el.onload = () => resolve();
      el.onerror = () => reject(new Error(src));
      document.body.appendChild(el);
    });
  }

  async function start() {
    const W = root ? root.clientWidth : 220;
    const H = root ? root.clientHeight : 200;

    await loadScript("/whale/pixi.min.js");
    await loadScript("/whale/live2dcubismcore.min.js");
    await loadScript("/whale/cubism4.min.js");

    const PIXI = (window as any).PIXI;
    if (!PIXI?.live2d || !stage) return;

    app = new PIXI.Application({
      transparent: true,
      antialias: true,
      autoStart: true,
      width: W,
      height: H,
      resolution: Math.min(window.devicePixelRatio || 1, 2),
      autoDensity: true,
    });
    stage.appendChild(app.view);

    model = await PIXI.live2d.Live2DModel.from("/whale/model/model3.json", {
      idleMotionGroup: "idle",
      autoInteract: false,
    });

    // 留 4% 边距，免得动作幅度大时被画布切到
    const s = Math.min((W * 0.96) / ART.w, (H * 0.96) / ART.h);
    model.scale.set(s);
    model.x = (W - ART.w * s) / 2 - ART.x * s;
    model.y = (H - ART.h * s) / 2 - ART.y * s;
    app.stage.addChild(model);

    // 鼠标跟随（眼睛/头会看过来）
    let raf = 0;
    stage.addEventListener("pointermove", (e) => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        if (!model) return;
        const r = stage.getBoundingClientRect();
        model.focus(
          r.left + r.width / 2 - e.clientX > 0 ? -1 : 1,
          e.clientY < r.top + r.height * 0.45 ? 1 : -1,
        );
      });
    });

    stage.addEventListener("pointerenter", () => root?.classList.add("is-hot"));
    stage.addEventListener("pointerleave", () => {
      root?.classList.remove("is-hot");
      model?.focus(0, 0);
    });

    // 点一下：换表情 + 播动作 + 说句话
    stage.addEventListener("click", () => {
      try {
        model?.expression(EXPRESSIONS[Math.floor(Math.random() * EXPRESSIONS.length)]);
        model?.motion(MOTIONS[Math.floor(Math.random() * MOTIONS.length)]);
        window.setTimeout(() => model?.expression(), 2600);
      } catch {
        /* 忽略 */
      }
      say(TIPS[Math.floor(Math.random() * TIPS.length)] ?? TIPS[0]);
    });

    document.addEventListener("visibilitychange", () => {
      if (!app) return;
      if (document.hidden) app.ticker.stop();
      else app.ticker.start();
    });
  }

  function boot() {
    let off = false;
    try {
      off = localStorage.getItem(KEY) === "1";
    } catch {
      off = false;
    }
    if (off || window.innerWidth < 900) return;

    // 按视口比例定尺寸，宽屏大一点
    const w = Math.round(Math.max(180, Math.min(240, window.innerWidth * 0.17)));
    const h = Math.round(w * 0.909);
    if (root) {
      root.style.setProperty("--pet-w", `${w}px`);
      root.style.setProperty("--pet-h", `${h}px`);
      root.hidden = false;
    }

    start().catch(() => {
      if (root) root.hidden = true;
    });
  }

  const forIdle = window;
  if (typeof forIdle.requestIdleCallback === "function") {
    forIdle.requestIdleCallback(boot, { timeout: 3000 });
  } else {
    window.setTimeout(boot, 1800);
  }
</script>
