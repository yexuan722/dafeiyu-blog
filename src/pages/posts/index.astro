---
import Base from "../../layouts/Base.astro";
import { getSortedPosts } from "../../lib/post";

import PostCard from "../../components/PostCard.astro";

const posts = await getSortedPosts();
---

<Base
  variant="anime"
  active="posts"
  title="文章"
  description="大肥鱼鱼塘里的全部文章，按时间倒序。"
>
  <section class="page-block">
    <p class="eyebrow">文章</p>
    <h1 class="page-title">全部文章</h1>
    <p class="page-desc">共 {posts.length} 篇，新的在上。想按主题找就去 <a href="/tags/">标签页</a>。</p>

    <ul class="post-list">
      {
        posts.map((post) => (
          <PostCard post={post} />
        ))
      }
    </ul>

    {posts.length === 0 && <p class="empty">还一条鱼都没有，先投点鱼苗吧。</p>}
  </section>
</Base>
