---
import Base from "../layouts/Base.astro";
---

<Base title="404" description="这条鱼游走了。" variant="anime">
  <section class="page page-404">
    <div class="big">404</div>
    <h1>这条鱼游走了</h1>
    <p style="color:var(--dim);margin:0 auto 26px;max-width:26em">
      你要找的页面不存在，可能是链接写错了，也可能是本鱼还没写完。
    </p>
    <p style="margin:0 0 18px">
      <img
        src="/maid-still.webp"
        width="260"
        height="330"
        alt="大肥鱼立绘"
        style="width:132px;height:auto;opacity:.85"
      />
    </p>
    <a class="btn btn-primary" href="/">回首页看看别的</a>
  </section>
</Base>
