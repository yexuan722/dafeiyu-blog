---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { fmtDate, getSortedPosts, tagCounts } from "../lib/post";
const posts = await getSortedPosts();
const tags = tagCounts(posts);
const latest = posts[0];
const feed = posts.slice(0, 8);
---

<Base variant="anime" full overlay title="大肥鱼的鱼塘" description="折腾笔记、AI 工具，以及一些还没想明白的问题。">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-img" role="img" aria-label="DeepSeek 鲸鱼娘：蓝发女仆，身后拖着鲸鱼尾巴"></div>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-intro">
        <p class="hero-kicker">Dive Deeper · 折腾笔记</p>
        <h1 id="home-title">大肥鱼的<span class="tint">鱼塘</span></h1>
        <p class="hero-lead">记录 AI 工具、代码和日常折腾。<br />踩过的坑慢慢填，能复现的经验认真写。</p>
        <dl class="hero-facts">
          <div><dt>折腾笔记</dt><dd>{posts.length}<span> 篇</span></dd></div>
          <div><dt>话题标签</dt><dd>{tags.length}<span> 个</span></dd></div>
          <div><dt>最近发文</dt><dd class="fact-date">{latest ? fmtDate(latest.data.pubDate) : "还在酝酿"}</dd></div>
        </dl>
        {latest && (
          <a class="hero-feature" href={`/posts/${latest.id}/`}>
            <span class="feature-label">最近写了 <span aria-hidden="true">↗</span></span>
            <strong>{latest.data.title}</strong>
            <span class="feature-desc">{latest.data.description}</span>
          </a>
        )}
        <a class="hero-scroll" href="#feed-title">往下翻翻笔记 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>
  <div class="home-shell">
    <div class="home-grid">
      <section class="home-feed" aria-labelledby="feed-title">
        <div class="feed-head">
          <h2 id="feed-title">最新笔记</h2>
          <a class="more" href="/posts/">全部文章 →</a>
        </div>
        <ul class="post-list">{feed.map((post) => <PostCard post={post} />)}</ul>
        {posts.length === 0 && <p class="empty">还一条鱼都没有，先投点鱼苗吧。</p>}
      </section>
      <aside class="home-side" aria-label="鱼塘小站">
        <section class="card profile-card">
          <img class="avatar" src="/avatar.webp" alt="大肥鱼的头像" width="92" height="92" loading="lazy" />
          <h2>大肥鱼</h2>
          <p class="role">DeepSeek 看板鱼 · 干饭中</p>
          <p class="sign">吃白饭第一名，写笔记第二名。<br />踩过的坑，都记在鱼塘里。</p>
          <p class="profile-note">能复现的步骤才写，<br />猜的部分会标出来。</p>
        </section>
        <section class="card side-card" aria-labelledby="tag-title">
          <h2 class="side-title" id="tag-title">常写的话题</h2>
          <div class="mini-tags">
            {tags.slice(0, 6).map(({ tag }) => <a class="tag" href={`/tags/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
          </div>
        </section>
      </aside>
    </div>
  </div>
</Base>
