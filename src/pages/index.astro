---
import Base from "../layouts/Base.astro";
import {
  fmtDate,
  readingMinutes,
  getSortedPosts,
  tagCounts,
  plainText,
} from "../lib/post";

const posts = await getSortedPosts();
const tags = tagCounts(posts);
const totalWords = posts.reduce((sum, p) => sum + plainText(p.body ?? "").length, 0);
const latest = posts[0];
const feed = posts.slice(0, 8);
const topTags = tags.slice(0, 8);
---

<Base
  variant="anime"
  full
  overlay
  title="大肥鱼的鱼塘"
  description="折腾笔记、AI 工具，以及一些还没想明白的问题。"
>
  <section class="home-hero">
    <img
      class="hero-img"
      src="/hero.webp"
      alt="DeepSeek 鲸鱼娘：蓝发女仆，身后拖着鲸鱼尾巴"
      width="1280"
      height="714"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="hero-kicker">Dive Deeper · 折腾笔记</p>
      <h1>大肥鱼的<span class="tint">鱼塘</span></h1>
      <p class="hero-lead">
        折腾 AI 工具时的笔记、踩过的坑，以及一些做完之后回头看觉得「早知道就记下来」的结论。
        能复现的步骤才写，猜的部分会标出来。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/posts/">翻翻文章</a>
        <a class="btn" href="/tags/">按标签找</a>
      </div>
    </div>
  </section>

  <div class="home-shell">
    <div class="home-grid">
      <aside class="home-profile">
        <div class="card profile-card">
          <img
            class="avatar"
            src="/avatar.webp"
            alt="大肥鱼的头像"
            width="184"
            height="184"
            loading="lazy"
          />
          <h2>大肥鱼</h2>
          <p class="role">DeepSeek 看板鱼 · 干饭中</p>
          <p class="sign">吃白饭第一名，写笔记第二名。踩过的坑都记这儿了。</p>
          <ul class="p-links">
            <li><a href="/posts/">全部文章</a></li>
            <li><a href="/tags/">标签分类</a></li>
            <li><a href="/search/">站内搜索</a></li>
            <li><a href="/about/">关于本鱼</a></li>
            <li>
              <a href="https://github.com/yexuan722/dafeiyu-blog">本站源码</a>
            </li>
          </ul>
        </div>
      </aside>

      <section class="home-feed" aria-labelledby="feed-title">
        <div class="feed-head">
          <h2 id="feed-title">最新文章</h2>
          <a class="more" href="/posts/">全部 {posts.length} 篇 →</a>
        </div>

        <ul class="post-list">
          {
            feed.map((post) => (
              <li class="post-card">
                <a href={`/posts/${post.id}/`}>
                  <div class="card-main">
                    <div class="card-top">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {fmtDate(post.data.pubDate)}
                      </time>
                      <i class="sep" />
                      <span>约 {readingMinutes(post.body)} 分钟</span>
                    </div>
                    <h2>{post.data.title}</h2>
                    {post.data.description && <p class="desc">{post.data.description}</p>}
                    {post.data.tags.length > 0 && (
                      <div class="tags">
                        {post.data.tags.map((t) => (
                          <span class="tag">#{t}</span>
                        ))}
                      </div>
                    )}
                  </div>
                  <span class="card-go" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M9 5.5 16.5 12 9 18.5"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        {posts.length === 0 && <p class="empty">还一条鱼都没有，先投点鱼苗吧。</p>}
      </section>

      <aside class="home-side">
        <section class="card side-card" aria-labelledby="stat-title">
          <h2 class="side-title" id="stat-title">站点统计</h2>
          <ul class="stat-list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M6 3.5h8L19 8v12.5H6z M13.5 3.5V8H19"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"></path>
              </svg>
              <span>文章</span>
              <b>{posts.length}</b>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M4 11.5V5.5a1.5 1.5 0 0 1 1.5-1.5h6L20 12.5 12.5 20 4 11.5Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"></path>
                <circle cx="8.6" cy="8.6" r="1.3" fill="currentColor"></circle>
              </svg>
              <span>标签</span>
              <b>{tags.length}</b>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M5 6.5h14M5 12h14M5 17.5h9"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"></path>
              </svg>
              <span>总字数</span>
              <b>{totalWords.toLocaleString("zh-CN")}</b>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"></circle>
                <path
                  d="M12 7.6V12l3 1.9"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"></path>
              </svg>
              <span>最近更新</span>
              <b>{latest ? fmtDate(latest.data.pubDate).slice(5) : "—"}</b>
            </li>
          </ul>
        </section>

        <section class="card side-card" aria-labelledby="tag-title">
          <h2 class="side-title" id="tag-title">常翻的标签</h2>
          <div class="mini-tags">
            {
              topTags.map((t) => (
                <a class="tag" href={`/tags/?tag=${encodeURIComponent(t.tag)}`}>
                  #{t.tag}
                </a>
              ))
            }
            <a class="tag" href="/tags/">全部 →</a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</Base>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduce) {
    for (const card of document.querySelectorAll<HTMLElement>(".post-card")) {
      card.addEventListener("pointermove", (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
      });
    }
  }
</script>
