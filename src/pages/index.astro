---
import Base from "../layouts/Base.astro";
import { fmtDate, readingMinutes, getSortedPosts, allTags } from "../lib/post";

const posts = await getSortedPosts();
const tags = allTags(posts);
---

<Base variant="anime" active="posts">
  <section class="hero">
    <div class="hero-text">
      <span class="hero-badge">咕噜咕噜 · 正在营业</span>
      <h1>大肥鱼的<span class="tint">鱼塘</span></h1>
      <p class="hero-sub">
        折腾 AI 工具时的笔记、踩过的坑，以及一些做完之后回头看觉得「早知道就记下来」的结论。
        能复现的步骤才写，猜的部分会标出来。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#posts">翻翻文章</a>
        <a class="btn" href="/tags/">按标签找</a>
      </div>
      <ul class="hero-stats">
        <li>
          <b>{posts.length}</b>
          <span>篇文章</span>
        </li>
        <li>
          <b>{tags.length}</b>
          <span>个标签</span>
        </li>
        <li>
          <b>0</b>
          <span>行后端代码</span>
        </li>
      </ul>
    </div>

    <div class="hero-art">
      <span class="maid-glow" aria-hidden="true"></span>
      <video
        class="maid-video"
        id="maid-video"
        poster="/maid-poster.jpg"
        width="440"
        height="560"
        muted
        loop
        playsinline
        preload="none"
        aria-label="大肥鱼立绘：头发、裙摆和鲸鱼尾缓慢摆动"
      >
        <source src="/maid-loop.mp4" type="video/mp4" />
      </video>
      <div class="bubble">今天也要干饭！</div>
    </div>
  </section>

  <div class="section-head" id="posts">
    <h2>最近写的</h2>
    <span class="hint">{posts.length} 篇 · 新的在上</span>
  </div>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-card">
          <a href={`/posts/${post.id}/`}>
            <div class="card-top">
              <time datetime={post.data.pubDate.toISOString()}>
                {fmtDate(post.data.pubDate)}
              </time>
              <i class="sep" />
              <span>约 {readingMinutes(post.body)} 分钟</span>
            </div>
            <h2>{post.data.title}</h2>
            {post.data.description && <p class="desc">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((t) => (
                  <span class="tag">#{t}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  {
    posts.length === 0 && <p class="empty">还一条鱼都没有，先投点鱼苗吧。</p>
  }
</Base>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduce) {
    for (const card of document.querySelectorAll<HTMLElement>(".post-card")) {
      card.addEventListener("pointermove", (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
      });
    }
  }

  // ---- 首页立绘视频 ----
  const video = document.getElementById("maid-video") as HTMLVideoElement | null;

  if (video) {
    const conn = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const slow =
      conn?.saveData === true || /(^|-)2g$/.test(conn?.effectiveType ?? "");

    if (reduce || slow) {
      // 省流 / 减少动态效果：保持 preload="none"，只显示封面图，视频一个字节都不下载
    } else {
      let wanted = true;
      const play = () => {
        if (wanted) video.play().catch(() => {});
      };

      video.preload = "auto";
      play();

      // 滚出视口就暂停，省电
      new IntersectionObserver(
        (entries) => {
          wanted = entries[0]?.isIntersecting ?? true;
          if (wanted) play();
          else video.pause();
        },
        { threshold: 0.05 },
      ).observe(video);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) video.pause();
        else play();
      });
    }
  }
</script>
